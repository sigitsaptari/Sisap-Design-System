{
  "shadow": {
    "xs": {
      "$type": "shadow",
      "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "$description": "Shadows allow you to add depth and realism to designs by positioning elements on a z-axis."
    },
    "xs-skeuomorphic": {
      "$type": "shadow",
      "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.05), inset 0 -2px 0 0 rgba(0, 0, 0, 0.05), inset 0 0 0 1px rgba(0, 0, 0, 0.18)",
      "$description": "Used to create a subtle skeuomorphic effect in components such as buttons and tabs."
    },
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px -1px rgba(0, 0, 0, 0.1), 0 1px 3px 0 rgba(0, 0, 0, 0.1)",
      "$description": "Small elevation shadow for cards and dropdown items."
    },
    "md": {
      "$type": "shadow",
      "$value": "0 2px 4px -2px rgba(0, 0, 0, 0.06), 0 4px 6px -1px rgba(0, 0, 0, 0.1)",
      "$description": "Medium elevation shadow for dropdowns and popovers."
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 2px 2px -1px rgba(0, 0, 0, 0.04), 0 4px 6px -2px rgba(0, 0, 0, 0.03), 0 12px 16px -4px rgba(0, 0, 0, 0.08)",
      "$description": "Large elevation shadow for flyout menus and modals."
    },
    "xl": {
      "$type": "shadow",
      "$value": "0 3px 3px -1.5px rgba(0, 0, 0, 0.04), 0 8px 8px -4px rgba(0, 0, 0, 0.03), 0 20px 24px -4px rgba(0, 0, 0, 0.08)",
      "$description": "Extra-large elevation shadow for drawer panels and prominent dialogs."
    },
    "2xl": {
      "$type": "shadow",
      "$value": "0 4px 4px -2px rgba(0, 0, 0, 0.04), 0 24px 48px -12px rgba(0, 0, 0, 0.18)",
      "$description": "2XL shadow for full modals and dialog overlays."
    },
    "3xl": {
      "$type": "shadow",
      "$value": "0 5px 5px -2.5px rgba(0, 0, 0, 0.04), 0 32px 64px -12px rgba(0, 0, 0, 0.14)",
      "$description": "3XL deep elevation shadow."
    }
  },
  "focusRing": {
    "default": {
      "$type": "shadow",
      "$value": "0 0 0 2px #ffffff, 0 0 0 4px #9e77ed",
      "$description": "Brand focus ring for toggles and checkboxes."
    },
    "shadow-xs": {
      "$type": "shadow",
      "$value": "0 0 0 2px #ffffff, 0 0 0 4px #9e77ed, 0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "$description": "Focus ring with subtle shadow for buttons and tabs."
    },
    "shadow-xs-skeuomorphic": {
      "$type": "shadow",
      "$value": "0 0 0 2px #ffffff, 0 0 0 4px #9e77ed, 0 1px 2px 0 rgba(0, 0, 0, 0.05), inset 0 -2px 0 0 rgba(0, 0, 0, 0.05), inset 0 0 0 1px rgba(0, 0, 0, 0.18)",
      "$description": "Skeuomorphic button focus ring."
    },
    "shadow-sm": {
      "$type": "shadow",
      "$value": "0 0 0 2px #ffffff, 0 0 0 4px #9e77ed, 0 1px 2px -1px rgba(0, 0, 0, 0.1), 0 1px 3px 0 rgba(0, 0, 0, 0.1)",
      "$description": "Focus ring with small elevation shadow."
    },
    "error": {
      "$type": "shadow",
      "$value": "0 0 0 2px #ffffff, 0 0 0 4px #ef4444",
      "$description": "Error destructive focus ring."
    },
    "error-shadow-xs": {
      "$type": "shadow",
      "$value": "0 0 0 2px #ffffff, 0 0 0 4px #ef4444, 0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "$description": "Error focus ring with shadow."
    },
    "error-shadow-xs-skeuomorphic": {
      "$type": "shadow",
      "$value": "0 0 0 2px #ffffff, 0 0 0 4px #ef4444, 0 1px 2px 0 rgba(0, 0, 0, 0.05), inset 0 -2px 0 0 rgba(0, 0, 0, 0.05), inset 0 0 0 1px rgba(0, 0, 0, 0.18)",
      "$description": "Error skeuomorphic button focus ring."
    }
  },
  "blur": {
    "sm": { "$type": "dimension", "$value": "8px", "$description": "Backdrop blur small" },
    "md": { "$type": "dimension", "$value": "16px", "$description": "Backdrop blur medium" },
    "lg": { "$type": "dimension", "$value": "24px", "$description": "Backdrop blur large" },
    "xl": { "$type": "dimension", "$value": "40px", "$description": "Backdrop blur extra large" }
  }
}
